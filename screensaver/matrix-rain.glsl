// Matrix rain drawn entirely on the GPU: an mpv user shader that paints
// falling glyph columns over whatever mpv is "playing" (a tiny black frame).
// Nothing is decoded, so it costs almost no CPU and is sharp at any
// resolution. The glyph atlas at the end of this file is generated by
// ./build-glyphs; edit the code here and the glyph set there.

//!HOOK OUTPUT
//!BIND HOOKED
//!BIND GLYPHS
//!DESC matrix rain

#define FPS 30.0          // must match the frame rate the launcher asks for
#define ATLAS vec2(8.0, 8.0)  // glyph columns, rows in the atlas

const vec3 TRAIL = vec3(0.42, 0.48, 0.76);
const vec3 HEAD = vec3(0.92, 0.95, 1.00);

float hash(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// One sheet of rain. `rows` is how many glyphs fit down the screen, so a
// larger value is a smaller, more distant sheet.
vec3 sheet(vec2 px, vec2 size, float t, float rows, float seed, float gain) {
    float ch = size.y / rows;
    float cw = ch * 0.8;
    px.x += seed * 7.3;
    vec2 cell = floor(px / vec2(cw, ch));
    vec2 uv = fract(px / vec2(cw, ch));
    vec2 id = vec2(cell.x, seed);

    float speed = mix(5.0, 13.0, hash(id + 0.1));
    float len = mix(7.0, 20.0, hash(id + 0.2));
    float period = rows + len + mix(8.0, 50.0, hash(id + 0.3));
    float pos = t * speed + hash(id + 0.4) * period;
    float cycle = floor(pos / period);
    float d = pos - cycle * period - cell.y;   // glyphs behind the head

    // Most columns sit a pass out, which keeps the rain sparse.
    if (d < 0.0 || d > len || hash(vec2(cell.x + seed, cycle)) > 0.24)
        return vec3(0.0);

    // Glyphs are fixed for a pass, apart from the odd one that flickers.
    float flicker = floor(t * 0.4 + hash(cell + seed) * 9.0);
    float pick = hash(cell + vec2(cycle * 3.1, seed));
    if (hash(cell + seed + 0.7) > 0.8)
        pick = hash(cell + vec2(flicker, seed));
    float g = floor(pick * ATLAS.x * ATLAS.y);
    vec2 slot = vec2(mod(g, ATLAS.x), floor(g / ATLAS.x));
    float ink = texture(GLYPHS, (slot + uv) / ATLAS).r;

    float fade = pow(1.0 - d / len, 1.7);
    vec3 color = mix(TRAIL * fade, HEAD, step(d, 1.0));
    return color * ink * gain;
}

vec4 hook() {
    vec2 size = HOOKED_size;
    vec2 px = HOOKED_pos * size;
    float t = float(frame) / FPS;

    vec3 c = sheet(px, size, t, 78.0, 1.0, 0.45);
    c = max(c, sheet(px, size, t, 60.0, 2.0, 0.7));
    c = max(c, sheet(px, size, t, 46.0, 3.0, 1.0));
    return vec4(c, 1.0);
}

