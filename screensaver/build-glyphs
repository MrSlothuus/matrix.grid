#!/bin/bash

# Regenerate the glyph atlas embedded at the end of matrix-rain.glsl.
# Only needed after changing the glyph set or font. Requires ImageMagick and
# Noto Sans CJK (noto-fonts-cjk).
set -euo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
shader="$here/matrix-rain.glsl"
font=/usr/share/fonts/noto-cjk/NotoSansCJK-Medium.ttc
marker='// Generated by ./build-glyphs. Do not edit below this line.'

# 64 glyphs, laid out 8 x 8. Keep in step with ATLAS in the shader.
glyphs='アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789+=<>:□*|'
cols=8 rows=8 cell_w=32 cell_h=40

((${#glyphs} == cols * rows)) || { echo "Expected $((cols * rows)) glyphs, got ${#glyphs}" >&2; exit 1; }
grep -qxF "$marker" "$shader" || { echo "Marker line missing from $shader" >&2; exit 1; }

cells=()
for ((i = 0; i < ${#glyphs}; i++)); do
  cells+=( \( "label:${glyphs:i:1}" -trim +repage -gravity center -extent "${cell_w}x${cell_h}" \) )
done

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
{
  awk -v m="$marker" '{ print } $0 == m { exit }' "$shader"
  echo
  echo '//!TEXTURE GLYPHS'
  echo "//!SIZE $((cols * cell_w)) $((rows * cell_h))"
  echo '//!FORMAT r8'
  echo '//!FILTER LINEAR'
  magick -background black -fill white -font "$font" -pointsize 26 "${cells[@]}" +append \
    -crop "$((cols * cell_w))x${cell_h}" -append -depth 8 gray:- | xxd -p | tr -d '\n'
  echo
} >"$tmp"
cat "$tmp" >"$shader"
echo "Wrote $((cols * rows)) glyphs to $shader"
